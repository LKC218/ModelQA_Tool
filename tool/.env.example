# 复制为 .env.local（已 gitignore）并填入真实值；Token 在 G:\项目\服务器部署\private\modelqa-token.txt
# 服务器数据服务 Token（经 vite define 注入前端，内部工具可接受）
VITE_CLOUD_TOKEN=
# 审核端回传专用 Token（仅 POST /api/reviews/submit；在 private/submit-token.txt，随审核包注入）
VITE_CLOUD_SUBMIT_TOKEN=
# 生产站点基址（本地 dev proxy 目标；前端请求恒为同域相对路径）
VITE_CLOUD_BASE=https://3d.propanda.cn
