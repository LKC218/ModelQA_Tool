# 依赖
node_modules/

# 本地环境变量（云端 Token 等，不入库；模板见 tool/.env.example）
.env.local
tool/.env.local
.env.*.local

# 构建产物
dist/
tool/dist/

# 生成文件（由 tool/scripts/build/build-reviewer.mjs 生成）
tool/src/generated/

# 3D 模型资源（本地素材，不纳入版本管理）
Model/

# 日志
npm-debug.log*
*.log
*.err
tool/logs/

# IDE
.vscode/
.idea/
.vs/

# Playwright / 验收产物
.playwright-cli/
tool/output/

# 本地会话数据（工作日志、验证脚本与报告）
.workbuddy/

# WorkBuddy 会话临时文件
.wbapp_*.genie

# 本地辅助工具依赖与临时产物（不入库）
/package.json
/package-lock.json
tool/lock-check*.txt

# 本地诊断临时产物（一次性排查脚本、日志与截图，不入库）
/.chk.txt
/.diag*.txt
tool/__*.cjs
tool/*-log.txt
tool/*.png

# 系统文件
Thumbs.db
.DS_Store
